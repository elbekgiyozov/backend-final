                  "if (data._id) {",
                  "    pm.environment.set('lessonId', data._id);",
                  "    console.log('lessonId = ' + data._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"title\": \"Postman orqali yaratilgan dars\",\n    \"description\": \"API dokumentatsiyasini sinash uchun\",\n    \"level\": \"beginner\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/lessons",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "lessons"
              ]
            },
            "description": "Yangi dars. **Himoyalangan.**\n\n**Body:** `title` (majburiy), `description`, `level` (`beginner` | `intermediate` | `advanced`)\n\n> `createdBy` body'dan OLINMAYDI — u tokendan aniqlanadi, shuning uchun boshqa odam nomidan dars yaratib bo'lmaydi.\n\n> Yangi dars haqida bot adminlarga xabar yuboradi."
          },
          "response": []
        },
        {
          "name": "Darslar ro'yxati",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/lessons?page=1&limit=10&search=&level=",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "lessons"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Sahifa raqami (default 1)"
                },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Sahifadagi elementlar soni (max 50)"
                },
                {
                  "key": "search",
                  "value": "",
                  "description": "Dars nomi bo'yicha qidiruv (katta/kichik harf farqsiz)"
                },
                {
                  "key": "level",
                  "value": "",
                  "description": "beginner | intermediate | advanced"
                }
              ]
            },
            "description": "Barcha darslar — pagination, qidiruv va daraja bo'yicha filtr bilan. Ochiq (token shart emas).\n\n**Javob tuzilishi:**\n```json\n{\n  \"data\": [ ... ],\n  \"pagination\": { \"page\": 1, \"limit\": 10, \"total\": 25, \"totalPages\": 3 }\n}\n```\n\n`createdBy` maydoni `populate` qilingan — ID o'rniga muallif ismi va emaili keladi."
          },
          "response": []
        },
        {
          "name": "Bitta dars",
          "request": {
            "auth": {
              "type": "noauth"
